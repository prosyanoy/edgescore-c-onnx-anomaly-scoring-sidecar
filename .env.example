# EdgeScore configuration. Every value is optional; the defaults below are safe for local use.
# Copy to .env and `set -a; source .env; set +a` before running ./build/edgescore.

# Model artifacts produced by `make model` (metadata is read from model.json beside the model
# unless EDGESCORE_MODEL_META is set).
EDGESCORE_MODEL=models/model.onnx
#EDGESCORE_MODEL_META=models/model.json

EDGESCORE_BIND=0.0.0.0
EDGESCORE_PORT=8088

# Splunk HEC token. Empty disables auth (fine for a pod-local sidecar). When set, clients must send
# `Authorization: Splunk <token>`. Never commit a real token.
EDGESCORE_HEC_TOKEN=

# Inference pipeline
EDGESCORE_WORKERS=2             # inference threads
EDGESCORE_INTRA_OP_THREADS=1    # ONNX Runtime threads per Run() call
EDGESCORE_QUEUE_CAPACITY=8192   # events; a full queue answers 503 (HEC code 9) = backpressure
EDGESCORE_MAX_BATCH=64          # max rows per model call
EDGESCORE_MAX_WAIT_US=2000      # max time a worker waits to fill a batch

# HTTP limits
EDGESCORE_MAX_CONNECTIONS=256
EDGESCORE_MAX_BODY_BYTES=8388608
EDGESCORE_SCORE_TIMEOUT_MS=5000 # /v1/score gives up waiting after this long

# Demo producer (k8s/producer.py)
#PRODUCER_TARGET=http://127.0.0.1:8088/services/collector/event
#PRODUCER_RATE=200
#PRODUCER_ANOMALY_RATE=0.03
